        { "action": "wait_for",       "target": "inventory_list",  "value": "" },
        { "action": "click",          "target": "add_to_cart",     "value": "" },
        { "action": "assert_visible", "target": "cart_badge",      "value": "" },
        { "action": "assert_text",    "target": "cart_badge",      "value": "1" }
      ]
    },
    {
