{
  "tests": [
    {
      "id": "TC001",
      "title": "Products page displays title and inventory list after login",
      "type": "ui",
      "tags": ["smoke", "products"],
      "expected": "After login the products page shows title 'Products' and the full inventory list",
      "steps": [
        { "action": "navigate",            "target": "${BASE_URL}",      "value": "" },
        { "action": "fill",                "target": "username_input",   "value": "${LOGIN_USER}" },
        { "action": "fill",                "target": "password_input",   "value": "${LOGIN_PASS}" },
        { "action": "click",               "target": "login_button",     "value": "" },
        { "action": "assert_url_contains", "target": "/inventory.html",  "value": "" },
        { "action": "assert_text",         "target": "page_title",       "value": "Products" },
        { "action": "assert_visible",      "target": "inventory_list",   "value": "" }
      ]
    },
    {
      "id": "TC002",
      "title": "Sort dropdown is visible on products page",
      "type": "ui",
      "tags": ["smoke", "sort", "products"],
      "expected": "The sort dropdown control is visible after login on the inventory page",
      "steps": [
        { "action": "navigate",       "target": "${BASE_URL}",     "value": "" },
        { "action": "fill",           "target": "username_input",  "value": "${LOGIN_USER}" },
        { "action": "fill",           "target": "password_input",  "value": "${LOGIN_PASS}" },
        { "action": "click",          "target": "login_button",    "value": "" },
        { "action": "wait_for",       "target": "inventory_list",  "value": "" },
        { "action": "assert_visible", "target": "sort_dropdown",   "value": "" }
      ]
    },
    {
      "id": "TC003",
      "title": "Sort by Price low to high reorders the product list",
      "type": "ui",
      "tags": ["sort", "products"],
      "expected": "Selecting Price (low to high) from the sort dropdown reorders products and prices remain visible",
      "steps": [
        { "action": "navigate",       "target": "${BASE_URL}",     "value": "" },
        { "action": "fill",           "target": "username_input",  "value": "${LOGIN_USER}" },
        { "action": "fill",           "target": "password_input",  "value": "${LOGIN_PASS}" },
        { "action": "click",          "target": "login_button",    "value": "" },
        { "action": "wait_for",       "target": "inventory_list",  "value": "" },
        { "action": "select",         "target": "sort_dropdown",   "value": "Price (low to high)" },
        { "action": "assert_visible", "target": "inventory_list",  "value": "" }
      ]
    },
    {
      "id": "TC004",
      "title": "Add to cart increments cart badge to 1",
      "type": "ui",
      "tags": ["smoke", "cart", "products"],
