{
  "tests": [
    {
      "id": "TC001",
      "title": "Product detail page loads after clicking product name",
      "type": "ui",
      "tags": ["smoke", "product-detail", "navigation"],
      "expected": "Clicking a product name on the inventory page navigates to the product detail page with URL containing inventory-item.html",
      "steps": [
        { "action": "navigate",           "target": "${BASE_URL}",       "value": "" },
        { "action": "fill",               "target": "username_input",    "value": "${LOGIN_USER}" },
        { "action": "fill",               "target": "password_input",    "value": "${LOGIN_PASS}" },
        { "action": "click",              "target": "login_button",      "value": "" },
        { "action": "wait_for",           "target": "inventory_list",    "value": "" },
        { "action": "click",              "target": "item_name",         "value": "" },
        { "action": "assert_url_contains","target": "inventory-item.html","value": "" }
      ]
    },
    {
      "id": "TC002",
