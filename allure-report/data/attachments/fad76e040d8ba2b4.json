{
  "tests": [
    {
      "id": "TC001",
      "title": "List users returns 200 with non-empty data within SLA",
      "type": "api",
      "tags": ["smoke", "users", "get"],
      "expected": "GET /users returns HTTP 200 with a non-empty array of user objects within 3000ms",
      "request": {
        "method": "GET",
        "url": "https://jsonplaceholder.typicode.com/users",
        "params": {},
        "headers": { "Accept": "application/json" },
        "body": ""
      },
      "assertions": [
        { "type": "status_code",     "path": "",          "expected": "200" },
        { "type": "not_empty",       "path": "[0].name",  "expected": "true" },
        { "type": "not_empty",       "path": "[0].email", "expected": "true" },
        { "type": "response_time_ms","path": "",          "expected": "3000" }
      ]
    },
    {
      "id": "TC002",
      "title": "Get single user ID=2 validates response schema",
      "type": "api",
      "tags": ["smoke", "users", "get", "contract"],
      "expected": "GET /users/2 returns HTTP 200 with a response matching the user JSON Schema",
      "request": {
        "method": "GET",
        "url": "https://jsonplaceholder.typicode.com/users/2",
        "params": {},
        "headers": { "Accept": "application/json" },
        "body": ""
      },
      "assertions": [
        { "type": "status_code", "path": "",            "expected": "200" },
        { "type": "json_path",   "path": "id",          "expected": "2" },
        { "type": "not_empty",   "path": "email",       "expected": "true" },
        { "type": "schema_file", "path": "",            "expected": "user.schema.json" }
      ]
    },
    {
      "id": "TC003",
      "title": "Get non-existent user ID=9999 returns 404",
      "type": "api",
      "tags": ["negative", "users", "get"],
      "expected": "GET /users/9999 returns HTTP 404 indicating the user does not exist",
      "request": {
        "method": "GET",
        "url": "https://jsonplaceholder.typicode.com/users/9999",
        "params": {},
        "headers": { "Accept": "application/json" },
        "body": ""
      },
      "assertions": [
        { "type": "status_code", "path": "", "expected": "404" }
      ]
    },
    {
      "id": "TC004",
      "title": "Create post returns 201 with generated ID",
      "type": "api",
      "tags": ["smoke", "posts", "post"],
      "expected": "POST /posts with title and body returns HTTP 201 with a generated id",
      "request": {
        "method": "POST",
        "url": "https://jsonplaceholder.typicode.com/posts",
        "params": {},
        "headers": { "Accept": "application/json", "Content-Type": "application/json" },
        "body": "{\"title\": \"QA Test Post\", \"body\": \"Generated by AI test runner\", \"userId\": 1}"
      },
      "assertions": [
        { "type": "status_code", "path": "",      "expected": "201" },
        { "type": "not_empty",   "path": "id",    "expected": "true" },
        { "type": "json_path",   "path": "title", "expected": "QA Test Post" }
      ]
    },
    {
      "id": "TC005",
      "title": "Update post ID=1 returns updated title",
      "type": "api",
      "tags": ["regression", "posts", "put"],
      "expected": "PUT /posts/1 returns HTTP 200 with the updated title in the response",
      "request": {
        "method": "PUT",
        "url": "https://jsonplaceholder.typicode.com/posts/1",
        "params": {},
        "headers": { "Accept": "application/json", "Content-Type": "application/json" },
        "body": "{\"id\": 1, \"title\": \"Updated Title\", \"body\": \"Updated body\", \"userId\": 1}"
      },
      "assertions": [
        { "type": "status_code", "path": "",      "expected": "200" },
        { "type": "json_path",   "path": "title", "expected": "Updated Title" }
      ]
    },
    {
      "id": "TC006",
      "title": "Delete post ID=1 returns 200",
      "type": "api",
      "tags": ["regression", "posts", "delete"],
      "expected": "DELETE /posts/1 returns HTTP 200 indicating successful deletion",
      "request": {
        "method": "DELETE",
        "url": "https://jsonplaceholder.typicode.com/posts/1",
        "params": {},
        "headers": { "Accept": "application/json" },
        "body": ""
      },
      "assertions": [
        { "type": "status_code", "path": "", "expected": "200" }
      ]
    },
    {
      "id": "TC007",
      "title": "List posts for user ID=1 returns non-empty results",
      "type": "api",
      "tags": ["edge-case", "posts", "filter"],
      "expected": "GET /posts?userId=1 returns HTTP 200 with posts belonging to user 1",
      "request": {
        "method": "GET",
        "url": "https://jsonplaceholder.typicode.com/posts",
        "params": { "userId": "1" },
        "headers": { "Accept": "application/json" },
        "body": ""
      },
      "assertions": [
        { "type": "status_code", "path": "",            "expected": "200" },
        { "type": "not_empty",   "path": "[0].title",   "expected": "true" },
        { "type": "json_path",   "path": "[0].userId",  "expected": "1" }
      ]
    }
  ]
}