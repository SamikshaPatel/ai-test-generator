{
  "tests": [
    {
      "id": "TC001",
      "title": "Adding item from inventory page shows cart badge with count 1",
      "type": "ui",
      "tags": ["smoke", "cart", "inventory"],
      "expected": "Clicking Add to Cart on the inventory page makes the cart badge appear showing the count 1",
      "steps": [
        { "action": "navigate",        "target": "${BASE_URL}",    "value": "" },
        { "action": "fill",            "target": "username_input", "value": "${LOGIN_USER}" },
        { "action": "fill",            "target": "password_input", "value": "${LOGIN_PASS}" },
        { "action": "click",           "target": "login_button",   "value": "" },
        { "action": "wait_for",        "target": "inventory_list", "value": "" },
        { "action": "click",           "target": "add_to_cart",    "value": "" },
        { "action": "wait_for",        "target": "cart_badge",     "value": "" },
        { "action": "assert_text",     "target": "cart_badge",     "value": "1" }
      ]
    },
