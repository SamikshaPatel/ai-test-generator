        { "action": "click",               "target": "add_to_cart",                "value": "" },
        { "action": "click",               "target": "cart_link",                  "value": "" },
        { "action": "click",               "target": ".checkout_button",           "value": "",
          "fallback_targets": ["[data-test='checkout']"] },
        { "action": "fill",                "target": "[data-test='firstName']",    "value": "QA" },
        { "action": "fill",                "target": "[data-test='lastName']",     "value": "Tester" },
        { "action": "fill",                "target": "[data-test='postalCode']",   "value": "12345" },
        { "action": "click",               "target": "[data-test='continue']",     "value": "" },
        { "action": "assert_url_contains", "target": "checkout-step-two.html",    "value": "" },
        { "action": "assert_visible",      "target": ".summary_subtotal_label",   "value": "" },
        { "action": "assert_visible",      "target": ".summary_tax_label",        "value": "" }
      ]
    },
    {
