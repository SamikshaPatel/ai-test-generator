      "title": "Checkout complete header text confirms order success",
      "type": "ui",
      "tags": ["smoke", "e2e", "checkout"],
      "expected": "The checkout complete page header contains 'Thank you' confirming the order",
      "steps": [
        { "action": "navigate",            "target": "${BASE_URL}",                "value": "" },
        { "action": "fill",                "target": "username_input",             "value": "${LOGIN_USER}" },
        { "action": "fill",                "target": "password_input",             "value": "${LOGIN_PASS}" },
        { "action": "click",               "target": "login_button",               "value": "" },
        { "action": "wait_for",            "target": "inventory_list",             "value": "" },
        { "action": "click",               "target": "add_to_cart",                "value": "" },
        { "action": "click",               "target": "cart_link",                  "value": "" },
        { "action": "click",               "target": ".checkout_button",           "value": "",
          "fallback_targets": ["[data-test='checkout']"] },
        { "action": "fill",                "target": "[data-test='firstName']",    "value": "QA" },
        { "action": "fill",                "target": "[data-test='lastName']",     "value": "Tester" },
        { "action": "fill",                "target": "[data-test='postalCode']",   "value": "12345" },
        { "action": "click",               "target": "[data-test='continue']",     "value": "" },
        { "action": "click",               "target": "[data-test='finish']",       "value": "" },
        { "action": "assert_text",         "target": ".complete-header",           "value": "Thank you" }
      ]
    }
  ]
}
