<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Docker-specific TestNG suite — identical to testng.xml except:
    thread-count="1" / parallel="none"

  Rationale: Chromium x86 binaries run under Rosetta 2 emulation on Apple Silicon.
  Three concurrent Chromium instances competing for Rosetta CPU translation cause
  intermittent JS-engine crashes ("Target crashed").  Running tests sequentially
  removes the concurrency pressure while keeping the same test set.

  On native amd64 CI (GitHub Actions, Jenkins) use testng.xml (thread-count=3)
  for full parallel speed.  Docker entrypoint selects this file via
  -Dtestng.suite.file=src/test/resources/testng-docker.xml.
-->
<suite name="AI Test Generator Suite (Docker)" verbose="1" thread-count="1" parallel="none" data-provider-thread-count="1">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.qa.ai.retry.RetryAnnotationTransformer"/>
    </listeners>

    <test name="Framework Validation" preserve-order="true">
        <classes>
            <class name="com.qa.ai.unit.PageRegistryValidationTest"/>
        </classes>
    </test>

    <test name="Login Page Tests" preserve-order="true">
        <classes>
            <class name="com.qa.ai.runner.AITestRunner_LoginPageTests"/>
        </classes>
    </test>

    <test name="Products Page Tests" preserve-order="true">
        <classes>
            <class name="com.qa.ai.runner.AITestRunner_ProductsPageTests"/>
        </classes>
    </test>

    <test name="Product Detail Page Tests" preserve-order="true">
        <classes>
            <class name="com.qa.ai.runner.AITestRunner_ProductDetailTests"/>
        </classes>
    </test>

    <test name="Add to Cart Tests" preserve-order="true">
        <classes>
            <class name="com.qa.ai.runner.AITestRunner_AddToCartTests"/>
        </classes>
    </test>

    <test name="Checkout E2E Tests" preserve-order="true">
        <classes>
            <class name="com.qa.ai.runner.AITestRunner_CheckoutE2ETests"/>
        </classes>
    </test>

    <test name="User API Tests" preserve-order="true">
        <classes>
            <class name="com.qa.ai.runner.AITestRunner_UserApiTests"/>
        </classes>
    </test>

    <test name="Posts API Tests" preserve-order="true">
        <classes>
            <class name="com.qa.ai.runner.AITestRunner_PostsApiTests"/>
        </classes>
    </test>

    <test name="Comments API Tests" preserve-order="true">
        <classes>
            <class name="com.qa.ai.runner.AITestRunner_CommentsApiTests"/>
        </classes>
    </test>

    <test name="Todos API Tests" preserve-order="true">
        <classes>
            <class name="com.qa.ai.runner.AITestRunner_TodosApiTests"/>
        </classes>
    </test>

</suite>
